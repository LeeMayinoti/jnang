story12:DancingAnimals_S12 a propp:Animal ;
    propp:hasRole story12:FailedSummoners ;
    rdfs:label "The animals who dance in turn" .

# Objects
story12:Eland_S12 a propp:Object ; rdfs:label "Eland (n!ang)" .
story12:Chyme_S12 a propp:Object ; rdfs:label "The eland's stomach contents (chyme)" .
story12:Coals_S12 a propp:Object ; rdfs:label "Coals of the boys' trail fires" .

# Magical Agents
story12:Meteor a propp:MagicalAgent ; rdfs:label "Meteor: 'the fire that hangs in the sky and kills people'" .

# Locations
story12:Trail_S12 a propp:Location ; rdfs:label "The Trail of Campfires" .
story12:ElandDeathPlace a propp:Location ; rdfs:label "The Eland's Death Place" .
story12:HomeVillage_S12 a propp:Location ; rdfs:label "The Home Village" .

# Narrative Functions
story12:S12_Move1_Hunt a propp:NarrativeFunction ;
    rdfs:label "!Xuma and Kha||'an go hunting and kill an eland" ;
    propp:involvesObject story12:Eland_S12 ;
    propp:occursAt story12:ElandDeathPlace .

story12:S12_Move2_Villainy a propp:NarrativeFunction ;
    rdfs:label "Lions kill the boys and bury them in the eland's chyme" ;
    propp:follows story12:S12_Move1_Hunt ;
    propp:involvesObject story12:Chyme_S12 ;
    propp:occursAt story12:ElandDeathPlace .

story12:S12_Move3_Tracking a propp:NarrativeFunction ;
    rdfs:label "The god tracks his sons; the turtle puts his head into each fire's coals" ;
    propp:follows story12:S12_Move2_Villainy ;
    propp:involvesObject story12:Coals_S12 ;
    propp:occursAt story12:Trail_S12 .

story12:S12_Move4_HotCoals a propp:NarrativeFunction ;
    rdfs:label "At the last fire the coals burn the turtle's head: the death place is near" ;
    propp:follows story12:S12_Move3_Tracking ;
    propp:involvesObject story12:Coals_S12 ;
    propp:occursAt story12:Trail_S12 .

story12:S12_Move5_Pretense a propp:NarrativeFunction ;
    rdfs:label "The god sees his sons in the chyme but pretends not to" ;
    propp:follows story12:S12_Move4_HotCoals ;
    propp:involvesObject story12:Chyme_S12 ;
    propp:occursAt story12:ElandDeathPlace .

story12:S12_Move6_BirdsSing a propp:NarrativeFunction ;
    rdfs:label "Pied babblers and other birds sing, but the boys do not emerge" ;
    propp:follows story12:S12_Move5_Pretense ;
    propp:occursAt story12:ElandDeathPlace .

story12:S12_Move7_AnimalsDance a propp:NarrativeFunction ;
    rdfs:label "All the animals dance in turn, but the boys still do not emerge" ;
    propp:follows story12:S12_Move6_BirdsSing ;
    propp:occursAt story12:ElandDeathPlace .

story12:S12_Move8_Meteor a propp:NarrativeFunction ;
    rdfs:label "The god hangs a meteor in a tree and calls it down; it blasts the chyme open" ;
    propp:follows story12:S12_Move7_AnimalsDance ;
    propp:involvesObject story12:Meteor, story12:Chyme_S12 ;
    propp:occursAt story12:ElandDeathPlace .

story12:S12_Move9_Resurrection a propp:NarrativeFunction ;
    rdfs:label "!Xuma and Kha||'an jump out of the chyme alive" ;
    propp:follows story12:S12_Move8_Meteor ;
    propp:occursAt story12:ElandDeathPlace .

story12:S12_Move10_Feast a propp:NarrativeFunction ;
    rdfs:label "They cook and eat the eland and take the rest home; the lions get none" ;
    propp:follows story12:S12_Move9_Resurrection ;
    propp:involvesObject story12:Eland_S12 ;
    propp:occursAt story12:HomeVillage_S12 .

# Character Links
story12:God_S12 propp:performsFunction story12:S12_Move3_Tracking, story12:S12_Move5_Pretense, story12:S12_Move8_Meteor, story12:S12_Move10_Feast ;
