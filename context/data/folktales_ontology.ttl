    propp:hasRole story13:ImmortalityGiver ;
    rdfs:label "Old man Moon" .

story13:Haregirl a propp:Animal ;
    propp:hasRole story13:FalseMessenger ;
    rdfs:label "The Haregirl" .

story13:Women_S13 a propp:Person ;
    propp:hasRole story13:Deceivers ;
    rdfs:label "The other women" .

story13:People_S13 a propp:Person ;
    rdfs:label "The People (when the animals were still people)" .

# Objects
story13:RaisinBerries_S13 a propp:Object ; rdfs:label "Raisin berries (red ripe / white unripe)" .
story13:Urine_S13 a propp:Object ; rdfs:label "The women's urine in the waterhole" .
story13:AmaBulb a propp:Object ; rdfs:label "!ama bulb" .
story13:DiggingStick_S13 a propp:Object ; rdfs:label "Digging stick" .
story13:Tortoise_S13 a propp:Object ; rdfs:label "Tortoise (Moon's bait)" .
story13:Axe_S13 a propp:Object ; rdfs:label "Axe" .
story13:GemsbokCloak a propp:Object ; rdfs:label "Charred female gemsbok skin cloak" .

# Magical Agents
story13:AnsweringUrine a propp:MagicalAgent ; rdfs:label "Urine commanded to answer in the women's place" .
story13:MoonRenewal a propp:MagicalAgent ; rdfs:label "Moon's power to die and live again" .

# Locations
story13:MoonHole a propp:Location ; rdfs:label "Moon's hole in the ground" .
story13:AbandonedVillage a propp:Location ; rdfs:label "The Abandoned Village (raisin berry patch)" .
story13:NewVillage a propp:Location ; rdfs:label "The New Village" .

# Narrative Functions
story13:S13_Move1_Disappearance a propp:NarrativeFunction ;
    rdfs:label "Old man Moon goes down into a hole; the people think he has died" ;
    propp:occursAt story13:MoonHole .

story13:S13_Move2_Relocation a propp:NarrativeFunction ;
    rdfs:label "The waterhole dies and the people move to another village" ;
    propp:follows story13:S13_Move1_Disappearance ;
    propp:occursAt story13:NewVillage .

story13:S13_Move3_Deception a propp:NarrativeFunction ;
    rdfs:label "The women trick the haregirl into gathering unripe white berries and send her back" ;
    propp:follows story13:S13_Move2_Relocation ;
    propp:involvesObject story13:RaisinBerries_S13 ;
    propp:occursAt story13:AbandonedVillage .

story13:S13_Move4_Abandonment a propp:NarrativeFunction ;
    rdfs:label "The women piss in the waterhole, tell the piss to answer for them, and leave" ;
    propp:follows story13:S13_Move3_Deception ;
    propp:involvesObject story13:Urine_S13, story13:AnsweringUrine ;
    propp:occursAt story13:AbandonedVillage .

story13:S13_Move5_FalseAnswer a propp:NarrativeFunction ;
    rdfs:label "The haregirl calls out and the piss answers" ;
    propp:follows story13:S13_Move4_Abandonment ;
    propp:involvesObject story13:AnsweringUrine ;
    propp:occursAt story13:AbandonedVillage .

story13:S13_Move6_Enticement a propp:NarrativeFunction ;
    rdfs:label "Moon, with a tortoise, entices the frightened haregirl to give him her !ama bulb" ;
    propp:follows story13:S13_Move5_FalseAnswer ;
    propp:involvesObject story13:Tortoise_S13, story13:AmaBulb ;
    propp:occursAt story13:MoonHole .

story13:S13_Move7_Capture a propp:NarrativeFunction ;
    rdfs:label "She offers the bulb on her digging stick; Moon pulls her into the hole" ;
    propp:follows story13:S13_Move6_Enticement ;
    propp:involvesObject story13:AmaBulb, story13:DiggingStick_S13 ;
    propp:occursAt story13:MoonHole .

story13:S13_Move8_Message a propp:NarrativeFunction ;
    rdfs:label "Moon: tell the people that when they die they will imitate me and live again" ;
    propp:follows story13:S13_Move7_Capture ;
    propp:involvesObject story13:MoonRenewal ;
    propp:occursAt story13:MoonHole .

story13:S13_Move9_DistortedMessage a propp:NarrativeFunction ;
    rdfs:label "The haregirl tells the people that the dead will not return and their flesh will smell" ;
    propp:follows story13:S13_Move8_Message ;
    propp:occursAt story13:NewVillage .

story13:S13_Move10_Punishment a propp:NarrativeFunction ;
    rdfs:label "Angry Moon splits her mouth with an axe: why the hare has a split lip" ;
    propp:follows story13:S13_Move9_DistortedMessage ;
    propp:involvesObject story13:Axe_S13 ;
    propp:occursAt story13:MoonHole .

story13:S13_Move11_Retaliation a propp:NarrativeFunction ;
    rdfs:label "She throws her charred gemsbok cloak on Moon's face: the marks on the moon" ;
    propp:follows story13:S13_Move10_Punishment ;
    propp:involvesObject story13:GemsbokCloak ;
    propp:occursAt story13:MoonHole .

# Character Links
story13:OldMoon propp:performsFunction story13:S13_Move1_Disappearance, story13:S13_Move6_Enticement, story13:S13_Move7_Capture, story13:S13_Move8_Message, story13:S13_Move10_Punishment ;
    propp:hasMagicalAgent story13:MoonRenewal .

story13:Haregirl propp:performsFunction story13:S13_Move5_FalseAnswer, story13:S13_Move7_Capture, story13:S13_Move9_DistortedMessage, story13:S13_Move11_Retaliation .
story13:Women_S13 propp:performsFunction story13:S13_Move3_Deception, story13:S13_Move4_Abandonment ;
    propp:hasMagicalAgent story13:AnsweringUrine .
story13:People_S13 propp:performsFunction story13:S13_Move2_Relocation, story13:S13_Move9_DistortedMessage .


