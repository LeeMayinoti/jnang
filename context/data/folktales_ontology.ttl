    propp:follows story14:S14_Move2_Journey ;
    propp:involvesObject story14:Ochre_S14, story14:SkyBirth ;
    propp:occursAt story14:MotherVillage_S14 .

story14:S14_Move4_Warning a propp:NarrativeFunction ;
    rdfs:label "The elephant girl tells her grandmother of her distrust and foretells the blood-wind" ;
    propp:follows story14:S14_Move3_SkyBirth ;
    propp:involvesObject story14:BloodWind .

story14:S14_Move5_ThornRuse a propp:NarrativeFunction ;
    rdfs:label "At an anthill the younger brother feigns a thorn and sends his shoes off as vultures, sending his brother away" ;
    propp:follows story14:S14_Move4_Warning ;
    propp:involvesObject story14:Thorn_S14, story14:Shoes_S14, story14:VultureShoes ;
    propp:occursAt story14:Anthill_S14 .

story14:S14_Move6_Murder a propp:NarrativeFunction ;
    rdfs:label "He asks the elephant girl to remove the thorn with her awl, then kills her with it" ;
    propp:follows story14:S14_Move5_ThornRuse ;
    propp:involvesObject story14:MetalAwl ;
    propp:occursAt story14:Anthill_S14 .

story14:S14_Move7_BloodWind a propp:NarrativeFunction ;
    rdfs:label "A little wind carries her blood to the grandmother, who keeps it in a jar" ;
    propp:follows story14:S14_Move6_Murder ;
    propp:involvesObject story14:BloodDroplets, story14:Jar_S14, story14:BloodWind .

story14:S14_Move8_Cannibalism a propp:NarrativeFunction ;
    rdfs:label "The younger brother roasts her; the husband returns and is pressed into eating his wife" ;
    propp:follows story14:S14_Move7_BloodWind ;
    propp:involvesObject story14:RoastedFlesh_S14 ;
    propp:occursAt story14:Anthill_S14 .

story14:S14_Move9_AnthillHiding a propp:NarrativeFunction ;
    rdfs:label "As her brothers approach, the anthill opens to hide the husband and closes" ;
    propp:follows story14:S14_Move8_Cannibalism ;
    propp:involvesObject story14:OpeningAnthill ;
    propp:occursAt story14:Anthill_S14 .

story14:S14_Move10_FailedRevenge a propp:NarrativeFunction ;
    rdfs:label "The younger brother perches on their spear points like a Gomhaya bird and defeats them" ;
    propp:follows story14:S14_Move9_AnthillHiding ;
    propp:involvesObject story14:Spears_S14, story14:GomhayaPerching ;
    propp:occursAt story14:Anthill_S14 .

story14:S14_Move11_Accusation a propp:NarrativeFunction ;
    rdfs:label "The brothers return home with the meat; the people accuse them of a great wrong" ;
    propp:follows story14:S14_Move10_FailedRevenge ;
    propp:involvesObject story14:RoastedFlesh_S14 ;
    propp:occursAt story14:EldersVillage .

story14:S14_Move12_Regrowth a propp:NarrativeFunction ;
    rdfs:label "The grandmother secretly grows the blood, splitting vessel after vessel, into a woman" ;
    propp:follows story14:S14_Move11_Accusation ;
    propp:involvesObject story14:Jar_S14, story14:BloodRegrowth .

story14:S14_Move13_Adornment a propp:NarrativeFunction ;
    rdfs:label "While the women gather, the grandmother dresses her in ochre and copper rings" ;
    propp:follows story14:S14_Move12_Regrowth ;
    propp:involvesObject story14:Ochre_S14, story14:CopperRings .

story14:S14_Move14_Recognition a propp:NarrativeFunction ;
    rdfs:label "The daughter recognizes her mother's laugh and nurses: 'The old people give you life'" ;
    propp:follows story14:S14_Move13_Adornment .

story14:S14_Move15_Donation a propp:NarrativeFunction ;
    rdfs:label "The frightened killers return; the grandmother secretly gives her a magical gemsbok horn" ;
    propp:follows story14:S14_Move14_Recognition ;
    propp:involvesObject story14:GemsbokHorn .

story14:S14_Move16_Journey a propp:NarrativeFunction ;
    rdfs:label "She travels with them to the in-laws, asking about every landmark on the way" ;
    propp:follows story14:S14_Move15_Donation .

story14:S14_Move17_Vengeance a propp:NarrativeFunction ;
    rdfs:label "She blows the horn and the brothers' village is broken apart and flattened" ;
    propp:follows story14:S14_Move16_Journey ;
    propp:involvesObject story14:GemsbokHorn ;
    propp:occursAt story14:InLawsVillage .

story14:S14_Move18_Return a propp:NarrativeFunction ;
    rdfs:label "The beautiful elephant girl walks home" ;
    propp:follows story14:S14_Move17_Vengeance .

