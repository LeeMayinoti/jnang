@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix propp: <http://ontology.narrative.org/propp#> .
@prefix story1: <http://ontology.narrative.org/moon-dies#> .
@prefix story2: <http://ontology.narrative.org/honey-flies#> .
@prefix story3: <http://ontology.narrative.org/woman-fire#> .
@prefix story4: <http://ontology.narrative.org/elephant-water#> .
@prefix story8: <http://ontology.narrative.org/sun-child#> .
@prefix story9: <http://ontology.narrative.org/tamsa-bird#> .
@prefix story10: <http://ontology.narrative.org/tug-of-war#> .
@prefix story11: <http://ontology.narrative.org/eyes-on-ankles#> .
@prefix story12: <http://ontology.narrative.org/two-boys-lions#> .
@prefix story13: <http://ontology.narrative.org/haregirl-moon#> .
@prefix story14: <http://ontology.narrative.org/elephant-girl#> .

# NOTE: Stories 5-7 (The Ostrich and the Tortoise, Springhare Dances, Ducks and
# People) are deliberately NOT formalized here -- they are held-out evaluation
# stories (see backend/app/eval/themes.py). Prefix numbers follow book chapters.
#
# NOTE: import_rdf.py keys Neo4j nodes on the URI local name only, so every
# local name must be unique across ALL stories (hence suffixes like _S8).

# =========================================================================
# SCHEMA DEFINITION (Classes & Properties)
# =========================================================================

# Classes
propp:Character a owl:Class ;
    rdfs:label "Character" .

propp:Person a owl:Class ;
    rdfs:subClassOf propp:Character ;
    rdfs:label "Person / Anthropomorphic Deity" .

propp:Animal a owl:Class ;
    rdfs:subClassOf propp:Character ;
    rdfs:label "Animal / Zoomorphic Character" .

propp:Object a owl:Class ;
    rdfs:label "Object" .

propp:MagicalAgent a owl:Class ;
    rdfs:subClassOf propp:Object ;
    rdfs:label "Magical Agent" .

propp:Location a owl:Class ;
    rdfs:label "Location" .

propp:NarrativeFunction a owl:Class ;
    rdfs:label "Narrative Function / Motifeme" .

propp:ProppianRole a owl:Class ;
    rdfs:label "Proppian Character Role" .

# Object Properties
propp:hasRole a owl:ObjectProperty ;
    rdfs:domain propp:Character ;
    rdfs:range propp:ProppianRole ;
    rdfs:label "has Proppian Role" .

propp:performsFunction a owl:ObjectProperty ;
    rdfs:domain propp:Character ;
    rdfs:range propp:NarrativeFunction ;
    rdfs:label "performs Narrative Function" .

propp:lacks a owl:ObjectProperty ;
    rdfs:domain propp:Character ;
    rdfs:range propp:MagicalAgent ;
    rdfs:label "lacks Magical Agent" .

propp:hasMagicalAgent a owl:ObjectProperty ;
    rdfs:domain propp:Character ;
    rdfs:range propp:MagicalAgent ;
    rdfs:label "possesses Magical Agent" .

propp:follows a owl:ObjectProperty ;
    rdfs:domain propp:NarrativeFunction ;
    rdfs:range propp:NarrativeFunction ;
    rdfs:label "sequentially follows" .

propp:occursAt a owl:ObjectProperty ;
    rdfs:domain propp:NarrativeFunction ;
    rdfs:range propp:Location ;
    rdfs:label "occurs at Location" .

propp:involvesObject a owl:ObjectProperty ;
    rdfs:domain propp:NarrativeFunction ;
    rdfs:range propp:Object ;
    rdfs:label "involves Object" .


# =========================================================================
# INSTANCE DATA: Story 1 - The Moon Dies and Lives Again
# =========================================================================

# Roles
story1:CelestialRejuvenator a propp:ProppianRole ; rdfs:label "Celestial Rejuvenator" .
story1:MortalWitness a propp:ProppianRole ; rdfs:label "Mortal Witness" .

# Characters
story1:Moon a propp:Person ;
    propp:hasRole story1:CelestialRejuvenator ;
    rdfs:label "The Moon (n!ui)" .

story1:Sun a propp:Person ;
    rdfs:label "The Sun (|am)" .

story1:People a propp:Person ;
    propp:hasRole story1:MortalWitness ;
    rdfs:label "The People (ju)" .

# Objects / Concepts
story1:Darkness a propp:Object ; rdfs:label "Darkness (djo)" .
story1:Night a propp:Object ; rdfs:label "Middle of the night (g!u !om)" .

# Magical Agents
story1:Rejuvenation a propp:MagicalAgent ; rdfs:label "Renewability / Resurrection Magic" .

# Locations
story1:Sky a propp:Location ; rdfs:label "The Sky (g!a'ama)" .

# Narrative Functions
story1:S1_Move1_Death a propp:NarrativeFunction ;
    rdfs:label "The Moon wanes and dies" ;
    propp:occursAt story1:Sky .

story1:S1_Move2_Darkness a propp:NarrativeFunction ;
    rdfs:label "The Moon returns to the dark place at midnight" ;
    propp:follows story1:S1_Move1_Death ;
    propp:involvesObject story1:Darkness, story1:Night ;
    propp:occursAt story1:Sky .

story1:S1_Move3_SunSets a propp:NarrativeFunction ;
    rdfs:label "The Sun goes down" ;
    propp:follows story1:S1_Move2_Darkness ;
    propp:occursAt story1:Sky .

story1:S1_Move4_Rebirth a propp:NarrativeFunction ;
    rdfs:label "The Moon returns, waxing into the big Moon again" ;
    propp:follows story1:S1_Move3_SunSets ;
    propp:occursAt story1:Sky .

story1:S1_Move5_Message a propp:NarrativeFunction ;
    rdfs:label "The Moon tells the people they will die and live again" ;
    propp:follows story1:S1_Move4_Rebirth ;
    propp:involvesObject story1:Rejuvenation .

# Character Links
story1:Moon propp:performsFunction story1:S1_Move1_Death, story1:S1_Move2_Darkness, story1:S1_Move4_Rebirth, story1:S1_Move5_Message ;
    propp:hasMagicalAgent story1:Rejuvenation .

story1:Sun propp:performsFunction story1:S1_Move3_SunSets .
story1:People propp:performsFunction story1:S1_Move5_Message .


# =========================================================================
# INSTANCE DATA: Story 2 - The Honey and the Flies
# =========================================================================

# Roles
story2:SkilledProvider a propp:ProppianRole ; rdfs:label "Skilled Provider / Successful Model" .
story2:IneptImitator a propp:ProppianRole ; rdfs:label "Inept Imitator / False Hero" .
story2:Healer a propp:ProppianRole ; rdfs:label "Healer / Donor" .

# Characters
story2:Woodpecker a propp:Animal ;
    propp:hasRole story2:SkilledProvider ;
    rdfs:label "Cardinal Woodpecker (!'aun!'aun)" .

story2:Glara a propp:Person ;
    propp:hasRole story2:IneptImitator ;
    rdfs:label "The God G!ara" .

story2:Flies a propp:Animal ;
    propp:hasRole story2:Healer ;
    rdfs:label "Flies (zoaqzoaq)" .

# Objects
story2:Honey a propp:Object ; rdfs:label "Honey (zo)" .
story2:CarryingPole a propp:Object ; rdfs:label "Carrying Pole (!aro)" .
story2:FlatDishes a propp:Object ; rdfs:label "Flat Dishes (tan-l'osi)" .

# Magical Agents
story2:WhistlingMagic a propp:MagicalAgent ; rdfs:label "Whistling Magic (||auhn)" .
story2:FlightAbility a propp:MagicalAgent ; rdfs:label "Ability to fly" .

# Locations
story2:Tree a propp:Location ; rdfs:label "High Tree (Bush)" .
story2:Ground a propp:Location ; rdfs:label "The Ground (Camp)" .

# Narrative Functions
story2:S2_Move1_Harvest a propp:NarrativeFunction ;
    rdfs:label "Woodpecker harvests honey high in tree" ;
    propp:involvesObject story2:Honey ;
    propp:occursAt story2:Tree .

story2:S2_Move2_WhistleDishes a propp:NarrativeFunction ;
    rdfs:label "Woodpecker whistles carrying pole and dishes up to tree" ;
    propp:follows story2:S2_Move1_Harvest ;
    propp:involvesObject story2:CarryingPole, story2:FlatDishes ;
    propp:occursAt story2:Tree .

story2:S2_Move3_Imitation a propp:NarrativeFunction ;
    rdfs:label "Glara attempts to imitate Woodpecker's harvest" ;
    propp:follows story2:S2_Move2_WhistleDishes ;
    propp:occursAt story2:Tree .

story2:S2_Move4_Failure a propp:NarrativeFunction ;
    rdfs:label "Glara fails to whistle up the dishes (they refuse)" ;
    propp:follows story2:S2_Move3_Imitation ;
    propp:occursAt story2:Tree .

story2:S2_Move5_Fall a propp:NarrativeFunction ;
    rdfs:label "Glara tries to fly but falls and his stomach bursts" ;
    propp:follows story2:S2_Move4_Failure ;
    propp:occursAt story2:Ground .

story2:S2_Move6_Rescue a propp:NarrativeFunction ;
    rdfs:label "Flies bite and sew up Glara's stomach" ;
    propp:follows story2:S2_Move5_Fall ;
    propp:occursAt story2:Ground .

# Character Links
story2:Woodpecker propp:performsFunction story2:S2_Move1_Harvest, story2:S2_Move2_WhistleDishes ;
    propp:hasMagicalAgent story2:WhistlingMagic, story2:FlightAbility .

story2:Glara propp:performsFunction story2:S2_Move3_Imitation, story2:S2_Move4_Failure, story2:S2_Move5_Fall ;
    propp:lacks story2:WhistlingMagic, story2:FlightAbility .

story2:Flies propp:performsFunction story2:S2_Move6_Rescue .


# =========================================================================
# INSTANCE DATA: Story 3 - A Woman First Found Fire
# =========================================================================

# Roles
story3:FireProvider a propp:ProppianRole ; rdfs:label "Fire Finder and Provider" .
story3:FireThief a propp:ProppianRole ; rdfs:label "Fire Thief" .

# Characters
story3:Woman a propp:Person ;
    propp:hasRole story3:FireProvider ;
    rdfs:label "First Woman (dshau)" .

story3:Husband a propp:Person ;
    propp:hasRole story3:FireThief ;
    rdfs:label "The Husband (!'hoan)" .

story3:Children a propp:Person ;
    rdfs:label "The Children (si!a)" .

# Objects
story3:Fire a propp:Object ; rdfs:label "Fire (da'a)" .
story3:CookedFood a propp:Object ; rdfs:label "Cooked Food" .
story3:RawFood a propp:Object ; rdfs:label "Raw Food" .

# Locations
story3:CampFireSite a propp:Location ; rdfs:label "The Camp (Fire Site)" .
story3:TheDarkness a propp:Location ; rdfs:label "The Dark (gFu n!ang)" .

# Narrative Functions
story3:S3_Move1_Discovery a propp:NarrativeFunction ;
    rdfs:label "Woman finds fire first" ;
    propp:involvesObject story3:Fire ;
    propp:occursAt story3:CampFireSite .

story3:S3_Move2_Nurturing a propp:NarrativeFunction ;
    rdfs:label "Woman cooks food and feeds the children" ;
    propp:follows story3:S3_Move1_Discovery ;
    propp:involvesObject story3:CookedFood ;
    propp:occursAt story3:CampFireSite .

story3:S3_Move3_HusbandDeprived a propp:NarrativeFunction ;
    rdfs:label "Husband sleeps in dark and eats raw food" ;
    propp:follows story3:S3_Move2_Nurturing ;
    propp:involvesObject story3:RawFood ;
    propp:occursAt story3:TheDarkness .

story3:S3_Move4_Theft a propp:NarrativeFunction ;
    rdfs:label "Husband steals the fire from his wife" ;
    propp:follows story3:S3_Move3_HusbandDeprived ;
    propp:involvesObject story3:Fire ;
    propp:occursAt story3:CampFireSite .

story3:S3_Move5_Propagation a propp:NarrativeFunction ;
    rdfs:label "Husband spreads fire throughout the world" ;
    propp:follows story3:S3_Move4_Theft ;
    propp:involvesObject story3:Fire .

# Character Links
story3:Woman propp:performsFunction story3:S3_Move1_Discovery, story3:S3_Move2_Nurturing .
story3:Husband propp:performsFunction story3:S3_Move3_HusbandDeprived, story3:S3_Move4_Theft, story3:S3_Move5_Propagation .
story3:Children propp:performsFunction story3:S3_Move2_Nurturing .


# =========================================================================
# INSTANCE DATA: Story 4 - The Elephant First Found Water
# =========================================================================

# Roles
story4:ResourceHoarder a propp:ProppianRole ; rdfs:label "Resource Hoarder" .
story4:Intermediary a propp:ProppianRole ; rdfs:label "Intermediary / Informant" .
story4:EgalitarianDefenders a propp:ProppianRole ; rdfs:label "Egalitarian Defenders / Liberators" .

# Characters
story4:Elephant a propp:Animal ;
    propp:hasRole story4:ResourceHoarder ;
    rdfs:label "The Elephant (!xo)" .

story4:AardvarkGirl a propp:Animal ;
    propp:hasRole story4:Intermediary ;
    rdfs:label "Beautiful Aardvark Girl (G!kun||homdima)" .

story4:Brothers a propp:Animal ;
    propp:hasRole story4:EgalitarianDefenders ;
    rdfs:label "Aardvark Girl's brothers (Swallows of the rain)" .

# Objects
story4:Water a propp:Object ; rdfs:label "Water (g!u)" .
story4:Mud a propp:Object ; rdfs:label "Mud (g‡kaa)" .
story4:Urine a propp:Object ; rdfs:label "Urine (waq)" .
story4:Spears a propp:Object ; rdfs:label "Spears / Spearpoints (!u!usi)" .

# Magical Agents
story4:RainmakingPower a propp:MagicalAgent ; rdfs:label "Power to fall as rain" .

# Locations
story4:SecretWaterhole a propp:Location ; rdfs:label "Secret Waterhole" .
story4:ForestBush a propp:Location ; rdfs:label "The Bush" .
story4:HomeCamp a propp:Location ; rdfs:label "The Camp" .

# Narrative Functions
story4:S4_Move1_Hoarding a propp:NarrativeFunction ;
    rdfs:label "Elephant hides water and drinks alone" ;
    propp:involvesObject story4:Water ;
    propp:occursAt story4:SecretWaterhole .

story4:S4_Move2_Exposure a propp:NarrativeFunction ;
    rdfs:label "Mud on ankles exposes Elephant's hoarding" ;
    propp:follows story4:S4_Move1_Hoarding ;
    propp:involvesObject story4:Mud ;
    propp:occursAt story4:HomeCamp .

story4:S4_Move3_Tracking a propp:NarrativeFunction ;
    rdfs:label "Brothers track Elephant to waterhole" ;
    propp:follows story4:S4_Move2_Exposure ;
    propp:occursAt story4:SecretWaterhole .

story4:S4_Move4_Sabotage a propp:NarrativeFunction ;
    rdfs:label "Brothers drink water and urinate in the waterhole" ;
    propp:follows story4:S4_Move3_Tracking ;
    propp:involvesObject story4:Urine ;
    propp:occursAt story4:SecretWaterhole .

story4:S4_Move5_Confrontation a propp:NarrativeFunction ;
    rdfs:label "Urine refuses Elephant; Elephant attempts to grab wife with trunk" ;
    propp:follows story4:S4_Move4_Sabotage ;
    propp:involvesObject story4:Urine ;
    propp:occursAt story4:SecretWaterhole .

story4:S4_Move6_Slaying a propp:NarrativeFunction ;
    rdfs:label "Brothers slay Elephant with hammered spears" ;
    propp:follows story4:S4_Move5_Confrontation ;
    propp:involvesObject story4:Spears ;
    propp:occursAt story4:SecretWaterhole .

story4:S4_Move7_Rainmaking a propp:NarrativeFunction ;
    rdfs:label "Elephant dies and causes rain to fall for everyone" ;
    propp:follows story4:S4_Move6_Slaying ;
    propp:involvesObject story4:RainmakingPower .

# Character Links
story4:Elephant propp:performsFunction story4:S4_Move1_Hoarding, story4:S4_Move5_Confrontation, story4:S4_Move7_Rainmaking ;
    propp:hasMagicalAgent story4:RainmakingPower .

story4:AardvarkGirl propp:performsFunction story4:S4_Move2_Exposure .
story4:Brothers propp:performsFunction story4:S4_Move3_Tracking, story4:S4_Move4_Sabotage, story4:S4_Move6_Slaying .



# =========================================================================
# INSTANCE DATA: Story 8 - The Sun's Child
# =========================================================================

# Roles
story8:DepartingProvider a propp:ProppianRole ; rdfs:label "Departing Provider / Celestial Mother" .
story8:GreedyChild a propp:ProppianRole ; rdfs:label "Greedy, Refusing Child" .

# Characters
story8:SunMother a propp:Person ;
    propp:hasRole story8:DepartingProvider ;
    rdfs:label "The Sun as a woman (|am)" .

story8:SunChild a propp:Person ;
    propp:hasRole story8:GreedyChild ;
    rdfs:label "The Sun's child (da'ama)" .

# Objects
story8:Tortoise_S8 a propp:Object ; rdfs:label "Roasted tortoise (zam)" .
story8:RaisinBerries_S8 a propp:Object ; rdfs:label "Raisin berries" .
story8:SkinCloak_S8 a propp:Object ; rdfs:label "Skin cloak (kaross)" .

# Magical Agents
story8:SkyLeap a propp:MagicalAgent ; rdfs:label "Power to leap into the sky and become the sun" .
story8:SunbirdTransformation a propp:MagicalAgent ; rdfs:label "Transformation into the white-bellied sunbird" .

# Locations
story8:Shade_S8 a propp:Location ; rdfs:label "The Shade (!hari)" .
story8:Sky_S8 a propp:Location ; rdfs:label "The Sky" .

# Narrative Functions
story8:S8_Move1_Roast a propp:NarrativeFunction ;
    rdfs:label "The Sun, still a person, roasts a tortoise and shares it with her son" ;
    propp:involvesObject story8:Tortoise_S8 .

story8:S8_Move2_Greed a propp:NarrativeFunction ;
    rdfs:label "The son wants to eat all the meat himself and cries" ;
    propp:follows story8:S8_Move1_Roast ;
    propp:involvesObject story8:Tortoise_S8 .

story8:S8_Move3_LeftInShade a propp:NarrativeFunction ;
    rdfs:label "The Sun leaves the crying child in the shade and gathers raisin berries" ;
    propp:follows story8:S8_Move2_Greed ;
    propp:involvesObject story8:RaisinBerries_S8 ;
    propp:occursAt story8:Shade_S8 .

story8:S8_Move4_Refusal a propp:NarrativeFunction ;
    rdfs:label "On her return the child is still crying and refuses to be picked up" ;
    propp:follows story8:S8_Move3_LeftInShade ;
    propp:occursAt story8:Shade_S8 .

story8:S8_Move5_Ascension a propp:NarrativeFunction ;
    rdfs:label "The Sun tucks her cloak between her legs, jumps into the sky and becomes the sun" ;
    propp:follows story8:S8_Move4_Refusal ;
    propp:involvesObject story8:SkinCloak_S8, story8:SkyLeap ;
    propp:occursAt story8:Sky_S8 .

story8:S8_Move6_Sunbird a propp:NarrativeFunction ;
    rdfs:label "The child becomes the white-bellied sunbird, forever crying 'Wah, wah, wah!'" ;
    propp:follows story8:S8_Move5_Ascension ;
    propp:involvesObject story8:SunbirdTransformation .

# Character Links
story8:SunMother propp:performsFunction story8:S8_Move1_Roast, story8:S8_Move3_LeftInShade, story8:S8_Move5_Ascension ;
    propp:hasMagicalAgent story8:SkyLeap .

story8:SunChild propp:performsFunction story8:S8_Move2_Greed, story8:S8_Move4_Refusal, story8:S8_Move6_Sunbird ;
    propp:hasMagicalAgent story8:SunbirdTransformation .


# =========================================================================
# INSTANCE DATA: Story 9 - The Tamsa Bird
# =========================================================================

# Roles
story9:SelfishHusband a propp:ProppianRole ; rdfs:label "Selfish Husband / Villain" .
story9:DeprivedWives a propp:ProppianRole ; rdfs:label "Deprived Wives" .
story9:RefusingVictim a propp:ProppianRole ; rdfs:label "Reluctant Dancer / Victim" .

# Characters
story9:God_S9 a propp:Person ;
    propp:hasRole story9:SelfishHusband ;
    rdfs:label "The God (husband of the two hornbill wives)" .

story9:GreyHornbill a propp:Animal ;
    propp:hasRole story9:DeprivedWives ;
    rdfs:label "Grey hornbill wife (Tockus nasutus)" .

story9:YellowBilledHornbill a propp:Animal ;
    propp:hasRole story9:DeprivedWives ;
    rdfs:label "Yellow-billed hornbill wife (Tockus flavirostris)" .

story9:TallWoman a propp:Person ;
    propp:hasRole story9:RefusingVictim ;
    rdfs:label "The tall woman across the fire" .

# Objects
story9:GxaruRoots_S9 a propp:Object ; rdfs:label "g||xaru roots (Lapeirousia bainesii)" .
story9:Sack_S9 a propp:Object ; rdfs:label "Hanging sack (claimed to hold sand)" .
story9:WoodenPaddle_S9 a propp:Object ; rdfs:label "Long wooden paddle" .
story9:Bangles_S9 a propp:Object ; rdfs:label "Clinking bangles" .

# Locations
story9:Bush_S9 a propp:Location ; rdfs:label "The Bush (digging grounds)" .
story9:DanceFire_S9 a propp:Location ; rdfs:label "The Dance Circle by the Fire" .

# Narrative Functions
story9:S9_Move1_Gathering a propp:NarrativeFunction ;
    rdfs:label "The god digs g||xaru roots and fills a sack" ;
    propp:involvesObject story9:GxaruRoots_S9, story9:Sack_S9 ;
    propp:occursAt story9:Bush_S9 .

story9:S9_Move2_Deception a propp:NarrativeFunction ;
    rdfs:label "Refusing to share, the god hangs the sack and pretends it holds sand" ;
    propp:follows story9:S9_Move1_Gathering ;
    propp:involvesObject story9:Sack_S9 .

story9:S9_Move3_SecretEating a propp:NarrativeFunction ;
    rdfs:label "During the dance the god secretly eats g||xaru from the sack" ;
    propp:follows story9:S9_Move2_Deception ;
    propp:involvesObject story9:GxaruRoots_S9 ;
    propp:occursAt story9:DanceFire_S9 .

story9:S9_Move4_PreparesWeapon a propp:NarrativeFunction ;
    rdfs:label "The god prepares a long wooden paddle and lays it by" ;
    propp:follows story9:S9_Move3_SecretEating ;
    propp:involvesObject story9:WoodenPaddle_S9 .

story9:S9_Move5_Demand a propp:NarrativeFunction ;
    rdfs:label "The god rejects his wives as dancers and calls for the tall woman" ;
    propp:follows story9:S9_Move4_PreparesWeapon ;
    propp:occursAt story9:DanceFire_S9 .

story9:S9_Move6_Refusals a propp:NarrativeFunction ;
    rdfs:label "The tall woman ignores him and keeps singing; he refuses another dancer and calls again" ;
    propp:follows story9:S9_Move5_Demand ;
    propp:occursAt story9:DanceFire_S9 .

story9:S9_Move7_Dance a propp:NarrativeFunction ;
    rdfs:label "Much later the tall woman, bangles clinking, comes and dances with him" ;
    propp:follows story9:S9_Move6_Refusals ;
    propp:involvesObject story9:Bangles_S9 ;
    propp:occursAt story9:DanceFire_S9 .

story9:S9_Move8_Murder a propp:NarrativeFunction ;
    rdfs:label "The god beats her stomach with the paddle, throws her down, and she dies" ;
    propp:follows story9:S9_Move7_Dance ;
    propp:involvesObject story9:WoodenPaddle_S9 ;
    propp:occursAt story9:DanceFire_S9 .

story9:S9_Move9_SelfPraise a propp:NarrativeFunction ;
    rdfs:label "The dance breaks up; alone, the god praises himself: 'This is how I do things!'" ;
    propp:follows story9:S9_Move8_Murder ;
    propp:occursAt story9:DanceFire_S9 .

# Character Links
story9:God_S9 propp:performsFunction story9:S9_Move1_Gathering, story9:S9_Move2_Deception, story9:S9_Move3_SecretEating, story9:S9_Move4_PreparesWeapon, story9:S9_Move5_Demand, story9:S9_Move8_Murder, story9:S9_Move9_SelfPraise .

story9:GreyHornbill propp:performsFunction story9:S9_Move5_Demand .
story9:YellowBilledHornbill propp:performsFunction story9:S9_Move5_Demand .
story9:TallWoman propp:performsFunction story9:S9_Move6_Refusals, story9:S9_Move7_Dance .


# =========================================================================
# INSTANCE DATA: Story 10 - Tug-of-War
# =========================================================================

# Roles
story10:OriginalOwner a propp:ProppianRole ; rdfs:label "Original Owner / Dupe" .
story10:Usurper a propp:ProppianRole ; rdfs:label "Usurper / Trickster-Victor" .

# Characters
story10:OmaOma a propp:Person ;
    propp:hasRole story10:OriginalOwner ;
    rdfs:label "|'Oma|'Oma (a Ju|'hoan man)" .

story10:BlackMan a propp:Person ;
    propp:hasRole story10:Usurper ;
    rdfs:label "The Black man (newcomer)" .

# Objects
story10:Cattle_S10 a propp:Object ; rdfs:label "The first cattle" .
story10:Milk_S10 a propp:Object ; rdfs:label "Milk" .
story10:Pot_S10 a propp:Object ; rdfs:label "Cooking pot" .
story10:LeatherRiem a propp:Object ; rdfs:label "Leather riem (thong)" .
story10:String_S10 a propp:Object ; rdfs:label "Piece of string" .
story10:Crops_S10 a propp:Object ; rdfs:label "Sorghum and maize" .
story10:RaisinBerries_S10 a propp:Object ; rdfs:label "Three kinds of raisin berries" .

# Locations
story10:Bush_S10 a propp:Location ; rdfs:label "The Bush (open grazing, no kraal)" .
story10:Village_S10 a propp:Location ; rdfs:label "The Village" .

# Narrative Functions
story10:S10_Move1_Ownership a propp:NarrativeFunction ;
    rdfs:label "|'Oma|'Oma owns the first cattle and herds them alone without a kraal" ;
    propp:involvesObject story10:Cattle_S10 ;
    propp:occursAt story10:Bush_S10 .

story10:S10_Move2_Inquiry a propp:NarrativeFunction ;
    rdfs:label "A Black man arrives and asks whose cattle they are" ;
    propp:follows story10:S10_Move1_Ownership ;
    propp:involvesObject story10:Cattle_S10 ;
    propp:occursAt story10:Bush_S10 .

story10:S10_Move3_HerdToVillage a propp:NarrativeFunction ;
    rdfs:label "They herd the cattle to the village together to spend the night" ;
    propp:follows story10:S10_Move2_Inquiry ;
    propp:involvesObject story10:Cattle_S10 ;
    propp:occursAt story10:Village_S10 .

story10:S10_Move4_Milking a propp:NarrativeFunction ;
    rdfs:label "Afraid of the cow, |'Oma|'Oma has the Black man tie her with a riem to milk her" ;
    propp:follows story10:S10_Move3_HerdToVillage ;
    propp:involvesObject story10:Milk_S10, story10:LeatherRiem ;
    propp:occursAt story10:Village_S10 .

story10:S10_Move5_PotRefusal a propp:NarrativeFunction ;
    rdfs:label "|'Oma|'Oma declines to share the milk, offering only to scrape the pot" ;
    propp:follows story10:S10_Move4_Milking ;
    propp:involvesObject story10:Pot_S10, story10:Milk_S10 ;
    propp:occursAt story10:Village_S10 .

story10:S10_Move6_TugOfWar a propp:NarrativeFunction ;
    rdfs:label "They pull opposite ends of a riem tied to a string; it breaks" ;
    propp:follows story10:S10_Move5_PotRefusal ;
    propp:involvesObject story10:LeatherRiem, story10:String_S10 ;
    propp:occursAt story10:Village_S10 .

story10:S10_Move7_Usurpation a propp:NarrativeFunction ;
    rdfs:label "Holding the riem, the Black man keeps the cattle and makes |'Oma|'Oma his servant" ;
    propp:follows story10:S10_Move6_TugOfWar ;
    propp:involvesObject story10:Cattle_S10, story10:LeatherRiem .

story10:S10_Move8_Origin a propp:NarrativeFunction ;
    rdfs:label "|'Oma|'Oma forages raisin berries while the Black man farms sorghum and maize and eats beef and milk" ;
    propp:follows story10:S10_Move7_Usurpation ;
    propp:involvesObject story10:RaisinBerries_S10, story10:Crops_S10 .

# Character Links
story10:OmaOma propp:performsFunction story10:S10_Move1_Ownership, story10:S10_Move3_HerdToVillage, story10:S10_Move5_PotRefusal, story10:S10_Move6_TugOfWar, story10:S10_Move8_Origin .

story10:BlackMan propp:performsFunction story10:S10_Move2_Inquiry, story10:S10_Move3_HerdToVillage, story10:S10_Move4_Milking, story10:S10_Move6_TugOfWar, story10:S10_Move7_Usurpation, story10:S10_Move8_Origin .


# =========================================================================
# INSTANCE DATA: Story 11 - Eyes-on-his-Ankles
# =========================================================================

# Roles
story11:AnomalousBeing a propp:ProppianRole ; rdfs:label "Anomalous Being / Victim" .
story11:Investigator a propp:ProppianRole ; rdfs:label "Investigator / Villain" .

# Characters
story11:EyesOnAnkles a propp:Person ;
    propp:hasRole story11:AnomalousBeing ;
    rdfs:label "Eyes-on-his-Ankles" .

story11:Companion_S11 a propp:Person ;
    propp:hasRole story11:Investigator ;
    rdfs:label "The other man (digging companion)" .

# Objects
story11:GxaruRoots_S11 a propp:Object ; rdfs:label "g||xaru roots (Lapeirousia bainesii)" .
story11:Sand_S11 a propp:Object ; rdfs:label "Flicked sand" .
story11:HotPaddle_S11 a propp:Object ; rdfs:label "Long wooden paddle heated in the fire" .

# Magical Agents
story11:AnkleEyes a propp:MagicalAgent ; rdfs:label "Eyes placed on the ankles" .

# Locations
story11:DiggingGround_S11 a propp:Location ; rdfs:label "The Digging Grounds" .
story11:Campfire_S11 a propp:Location ; rdfs:label "The Night Camp Fire" .

# Narrative Functions
story11:S11_Move1_Digging a propp:NarrativeFunction ;
    rdfs:label "Two men dig g||xaru roots together" ;
    propp:involvesObject story11:GxaruRoots_S11 ;
    propp:occursAt story11:DiggingGround_S11 .

story11:S11_Move2_Suspicion a propp:NarrativeFunction ;
    rdfs:label "At night the companion sees Eyes-on-his-Ankles has no eyes on his face" ;
    propp:follows story11:S11_Move1_Digging ;
    propp:occursAt story11:Campfire_S11 .

story11:S11_Move3_Test a propp:NarrativeFunction ;
    rdfs:label "He flicks sand on face, wrists, then ankles, where the eyes blink" ;
    propp:follows story11:S11_Move2_Suspicion ;
    propp:involvesObject story11:Sand_S11, story11:AnkleEyes ;
    propp:occursAt story11:Campfire_S11 .

story11:S11_Move4_Ruse a propp:NarrativeFunction ;
    rdfs:label "Next evening the companion offers to roast the roots and heats a wooden paddle" ;
    propp:follows story11:S11_Move3_Test ;
    propp:involvesObject story11:GxaruRoots_S11, story11:HotPaddle_S11 ;
    propp:occursAt story11:Campfire_S11 .

story11:S11_Move5_Wariness a propp:NarrativeFunction ;
    rdfs:label "Eyes-on-his-Ankles drops bundles of roots but tries to stand far away" ;
    propp:follows story11:S11_Move4_Ruse ;
    propp:involvesObject story11:GxaruRoots_S11 ;
    propp:occursAt story11:Campfire_S11 .

story11:S11_Move6_Killing a propp:NarrativeFunction ;
    rdfs:label "The companion burns his ankle-eyes open with the hot paddle and roasts him with the roots" ;
    propp:follows story11:S11_Move5_Wariness ;
    propp:involvesObject story11:HotPaddle_S11, story11:AnkleEyes ;
    propp:occursAt story11:Campfire_S11 .

# Character Links
story11:EyesOnAnkles propp:performsFunction story11:S11_Move1_Digging, story11:S11_Move5_Wariness ;
    propp:hasMagicalAgent story11:AnkleEyes .

story11:Companion_S11 propp:performsFunction story11:S11_Move1_Digging, story11:S11_Move2_Suspicion, story11:S11_Move3_Test, story11:S11_Move4_Ruse, story11:S11_Move6_Killing .


